  "item": [
    {
      "name": "1. POST /api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\npm.test('200 OK', function () {\n    pm.response.to.have.status(200);\n});\n\nlet jsonData;\n\ntry {\n    jsonData = pm.response.json();\n} catch (error) {\n    console.log('Response khong phai JSON hop le');\n}\n\nif (jsonData && jsonData.token && jsonData.role) {\n    const role = String(jsonData.role).toUpperCase();\n    const variableName = role + '_TOKEN';\n\n    // Luu token vao Environment dang duoc chon\n    pm.environment.set(variableName, jsonData.token);\n\n    console.log('Da luu token vao Environment: ' + variableName);\n\n    pm.test('Co token dang nhap', function () {\n        pm.expect(jsonData.token).to.be.a('string').and.not.empty;\n    });\n} else {\n    console.log('Khong tim thay token hoac role trong response');\n}\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"2\",\n  \"password\": \"2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Body: LoginRequest { username, password }.  \nKhông cần Authorization.  \nKết quả mong đợi: 200 OK, trả về token, type, userId, username, role.  \nTest script tự lưu token vào collection variable cho các API admin dùng sau."
      },
