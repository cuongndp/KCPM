  "item": [
    {
      "name": "1. POST /api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "const expectedStatus = Number(",
              "    pm.iterationData.get(\"expectedStatus\")",
              ");",
              "",
              "pm.test(\"Check Expected Status\", function () {",
              "    pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "let jsonData;",
              "",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (error) {",
              "    console.log(\"Response khong phai JSON\");",
              "}",
              "",
              "// Chỉ lưu token khi login thành công",
              "if (",
              "    pm.response.code >= 200 &&",
              "    pm.response.code < 300 &&",
              "    jsonData &&",
              "    jsonData.token &&",
              "    jsonData.role",
              ") {",
              "    const role = String(jsonData.role)",
              "        .toUpperCase()",
              "        .replace(/^ROLE_/, \"\")",
              "        .trim();",
              "",
              "    const tokenMap = {",
              "        ADMIN: \"ADMIN_TOKEN\",",
              "        DOCTOR: \"DOCTOR_TOKEN\",",
              "        PATIENT: \"PATIENT_TOKEN\"",
              "    };",
              "",
              "    const variableName = tokenMap[role];",
              "",
              "    if (variableName) {",
              "        pm.environment.set(",
              "            variableName,",
              "            jsonData.token",
              "        );",
              "",
              "        console.log(\"Saved: \" + variableName);",
              "    }",
              "",
              "    pm.test(\"Response co token\", function () {",
              "        pm.expect(jsonData.token)",
              "            .to.be.a(\"string\").and.not.empty;",
              "    });",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
