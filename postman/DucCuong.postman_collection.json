          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Tra ve danh sach bac si', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    if (jsonData.length > 0) {",
              "        pm.expect(jsonData[0]).to.have.property('id');",
              "        pm.expect(jsonData[0]).to.have.property('user');",
              "        pm.expect(jsonData[0]).to.have.property('department');",
              "        pm.expect(jsonData[0]).to.have.property('specialization');",
              "        pm.expect(jsonData[0]).to.have.property('available');",
              "        if (!pm.collectionVariables.get('doctorId')) {",
              "            pm.collectionVariables.set('doctorId', jsonData[0].id);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ],
