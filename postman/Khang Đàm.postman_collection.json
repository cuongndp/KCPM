      "name": "api/doctor/appointments",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "const expectedStatus = pm.iterationData.get(\"Expected_HTTP_Status\");\r",
              "const testCaseID = pm.iterationData.get(\"TestCaseID\");\r",
              "const doctorId = pm.iterationData.get(\"doctorId\");\r",
              "\r",
              "// 1. Kiểm tra dữ liệu CSV\r",
              "pm.test(\"CSV có mã HTTP mong đợi hợp lệ\", function () {\r",
              "    pm.expect(expectedStatus).to.not.be.undefined;\r",
              "    pm.expect(expectedStatus).to.not.equal(\"\");\r",
              "    pm.expect(Number(expectedStatus)).to.be.within(100, 599);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra HTTP Status\r",
              "if (\r",
              "    expectedStatus !== undefined &&\r",
              "    expectedStatus !== \"\" &&\r",
              "    !isNaN(Number(expectedStatus))\r",
              ") {\r",
              "    pm.test(\"Status code matches CSV\", function () {\r",
              "        pm.response.to.have.status(Number(expectedStatus));\r",
              "    });\r",
              "}\r",
              "\r",
              "// 3. Kiểm tra thời gian phản hồi\r",
              "pm.test(\"Response time dưới 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "// 4. Kiểm tra JSON\r",
              "let responseData;\r",
              "\r",
              "pm.test(\"Response trả về JSON hợp lệ\", function () {\r",
              "    responseData = pm.response.json();\r",
              "    pm.expect(responseData).to.exist;\r",
              "});\r",
              "\r",
              "// 5. Kiểm tra cấu trúc khi HTTP 200\r",
              "if (pm.response.code === 200) {\r",
              "    pm.test(\"Response có cấu trúc hợp lệ\", function () {\r",
              "        pm.expect(responseData).to.exist;\r",
              "    });\r",
              "\r",
              "    console.log(\"API trả về thành công\");\r",
              "}\r",
              "\r",
              "// 6. Ghi nhận kết quả\r",
              "console.log(\"Test Case:\", testCaseID);\r",
              "console.log(\"Doctor ID:\", doctorId);\r",
              "console.log(\"Expected:\", expectedStatus);\r",
              "console.log(\"Actual:\", pm.response.code);\r",
              "console.log(\"Response:\", pm.response.text());\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
