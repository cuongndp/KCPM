      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const expectedStatusText = String(",
              "    pm.iterationData.get(\"expectedStatus\")",
              ");",
              "",
              "const expectedStatus = Number(",
              "    expectedStatusText.match(/\\d{3}/)[0]",
              ");",
              "",
              "pm.test(\"Kiểm tra mã trạng thái HTTP\", function () {",
              "    pm.expect(pm.response.code).to.eql(expectedStatus);",
              "});",
              "",
              "pm.test(\"Kiểm tra API có phản hồi\", function () {",
              "    pm.expect(pm.response.code).to.be.a(\"number\");",
              "});",
              "",
              "console.log(\"TEST CASE:\", pm.iterationData.get(\"testCaseId\"));",
              "console.log(\"EXPECTED STATUS:\", expectedStatus);",
              "console.log(\"ACTUAL STATUS:\", pm.response.code);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              "const testCaseId = pm.iterationData.get(\"testCaseId\");\r",
              "\r",
              "// Xóa Authorization mặc định\r",
              "pm.request.headers.remove(\"Authorization\");\r",
              "\r",
              "let token = null;\r",
              "\r",
              "switch (testCaseId) {\r",
              "    case \"DEPT-011\":\r",
              "        // Không gửi token\r",
              "        break;\r",
              "\r",
              "    case \"DEPT-012\":\r",
              "        token = pm.environment.get(\"EXPIRED_TOKEN\");\r",
              "        break;\r",
              "\r",
              "    case \"DEPT-013\":\r",
              "        token = pm.environment.get(\"PATIENT_TOKEN\");\r",
              "        break;\r",
              "\r",
              "    case \"DEPT-014\":\r",
              "        token = pm.environment.get(\"DOCTOR_TOKEN\");\r",
              "        break;\r",
              "\r",
              "    default:\r",
              "        token = pm.environment.get(\"ADMIN_TOKEN\");\r",
              "        break;\r",
              "}\r",
              "\r",
              "if (token) {\r",
              "    pm.request.headers.upsert({\r",
              "        key: \"Authorization\",\r",
              "        value: \"Bearer \" + token\r",
              "    });\r",
              "}\r",
              "\r",
              "console.log(\"TEST CASE:\", testCaseId);\r",
              "console.log(\"AUTH:\", testCaseId === \"DEPT-011\"\r",
              "    ? \"No Token\"\r",
              "    : token ? \"Token configured\" : \"Missing Token\");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
