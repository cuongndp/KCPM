          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = Number(\n    pm.iterationData.get(\"Mã trạng thái mong đợi\")\n);\n\nconst testCase = pm.iterationData.get(\"Mã test case\");\n\nconsole.log(\"Test case:\", testCase);\nconsole.log(\"Expected:\", expected);\nconsole.log(\"Actual:\", pm.response.code);\n\npm.test(\"Kiểm tra mã HTTP theo CSV\", function () {\n    pm.response.to.have.status(expected);\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const mode = pm.iterationData.get(\"authMode\");\r\n\r\nif (mode === \"ADMIN\") {\r\n    pm.request.headers.upsert({\r\n        key: \"Authorization\",\r\n        value: \"Bearer \" + pm.environment.get(\"ADMIN_TOKEN\")\r\n    });\r\n}\r\nelse if (mode === \"PATIENT\") {\r\n    pm.request.headers.upsert({\r\n        key: \"Authorization\",\r\n        value: \"Bearer \" + pm.environment.get(\"PATIENT_TOKEN\")\r\n    });\r\n}\r\nelse if (mode === \"DOCTOR\") {\r\n    pm.request.headers.upsert({\r\n        key: \"Authorization\",\r\n        value: \"Bearer \" + pm.environment.get(\"DOCTOR_TOKEN\")\r\n    });\r\n}\r\nelse if (mode === \"INVALID\") {\r\n    pm.request.headers.upsert({\r\n        key: \"Authorization\",\r\n        value: pm.collectionVariables.get(\"bearer_token_162i\")\r\n    });\r\n}\r\nelse if (mode === \"NONE\") {\r\n    pm.request.headers.remove(\"Authorization\");\r\n}"
            ]
          }
        }
      ],
