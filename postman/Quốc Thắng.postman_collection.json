        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\nconst data = pm.iterationData.toObject();\n\nconsole.log(\"TEST CASE:\", data.testCaseId);\nconsole.log(\"SCENARIO:\", data.testScenario);\nconsole.log(\"REQUEST BODY:\", data.requestBody);\nconsole.log(\"STATUS MONG ĐỢI:\", data.expectedStatus);\nconsole.log(\"STATUS THỰC TẾ:\", pm.response.code);\n\n// Kiểm tra dữ liệu CSV\npm.test(\"CSV có dữ liệu đầu vào\", function () {\n    pm.expect(data.requestBody).to.exist;\n    pm.expect(data.testCaseId).to.exist;\n});\n\n// Lấy mã HTTP từ expectedStatus\npm.test(\"Mã HTTP đúng với CSV\", function () {\n    const expectedStatuses = String(data.expectedStatus)\n        .match(/\\d{3}/g)\n        .map(Number);\n\n    pm.expect(\n        expectedStatuses,\n        \"Không đọc được mã HTTP mong đợi\"\n    ).to.not.be.empty;\n\n    pm.expect(\n        expectedStatuses,\n        \"Mong đợi: \" + expectedStatuses.join(\" hoặc \") +\n        \" | Thực tế: \" + pm.response.code\n    ).to.include(pm.response.code);\n});\n"
            ]
          }
        }
      ],
